{
  "name": "smart-vcard",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "description": "Smart VCard — a privacy-first, bilingual vCard QR code studio that runs entirely in the browser.",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "智维ITMSKY",
    "url": "http://www.itmsky.com"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
 "typecheck": "tsc -b",
 "lint": "eslint .",
 "test": "node --import ./scripts/node-test-resolver.mjs --test \"tests/**/*.test.ts\"",
 "verify": "npm run lint && npm run build && npm test",
    "test:watch": "node --import ./scripts/node-test-resolver.mjs --test --watch \"tests/**/*.test.ts\"",
    "icons": "node scripts/make-icons.mjs",
    "preview": "vite preview",
    "archive": "node scripts/make-archive.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@tailwindcss/vite": "^4.3.5",
    "@unhead/react": "^3.3.1",
    "i18next": "^25.0.0",
    "i18next-browser-languagedetector": "^8.0.2",
    "jspdf": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.1.5",
    "svg2pdf.js": "^2.9.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "minimatch": "^10.2.6"
  }
}
